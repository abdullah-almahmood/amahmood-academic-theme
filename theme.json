{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": false,
    "layout": {
      "contentSize": "880px",
      "wideSize": "1380px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "custom": true,
      "palette": [
        {
          "slug": "lilac",
          "color": "#EFE9F8",
          "name": "Lilac, page ground"
        },
        {
          "slug": "surface",
          "color": "#E7DFF6",
          "name": "Surface, card"
        },
        {
          "slug": "deep",
          "color": "#DED3F1",
          "name": "Deep surface"
        },
        {
          "slug": "plum",
          "color": "#2B1B4D",
          "name": "Plum, body ink"
        },
        {
          "slug": "muted",
          "color": "#5A4880",
          "name": "Muted ink"
        },
        {
          "slug": "hair",
          "color": "#D2C4EC",
          "name": "Hairline"
        },
        {
          "slug": "violet",
          "color": "#6A35C9",
          "name": "Violet, accent"
        },
        {
          "slug": "night",
          "color": "#1B1030",
          "name": "Night"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "customFontSize": true,
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display, Bricolage Grotesque",
          "fontFamily": "'Bricolage Grotesque', 'Archivo', system-ui, sans-serif"
        },
        {
          "slug": "body",
          "name": "Body, Instrument Sans",
          "fontFamily": "'Instrument Sans', system-ui, -apple-system, 'Segoe UI', sans-serif"
        },
        {
          "slug": "mono",
          "name": "Data, IBM Plex Mono",
          "fontFamily": "'IBM Plex Mono', ui-monospace, SFMono-Regular, monospace"
        }
      ],
      "fontSizes": [
        {
          "slug": "x-small",
          "size": "0.74rem",
          "name": "X Small"
        },
        {
          "slug": "small",
          "size": "0.88rem",
          "name": "Small"
        },
        {
          "slug": "medium",
          "size": "1rem",
          "name": "Medium",
          "fluid": {
            "min": "0.95rem",
            "max": "1.06rem"
          }
        },
        {
          "slug": "large",
          "size": "1.35rem",
          "name": "Large",
          "fluid": {
            "min": "1.15rem",
            "max": "1.5rem"
          }
        },
        {
          "slug": "x-large",
          "size": "2.2rem",
          "name": "X Large",
          "fluid": {
            "min": "1.7rem",
            "max": "2.6rem"
          }
        },
        {
          "slug": "xx-large",
          "size": "3.6rem",
          "name": "XX Large",
          "fluid": {
            "min": "2.2rem",
            "max": "4.2rem"
          }
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "em",
        "rem",
        "vh",
        "vw",
        "%"
      ],
      "spacingScale": {
        "steps": 8
      }
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--lilac)",
      "text": "var(--wp--preset--color--plum)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.68"
    },
    "spacing": {
      "padding": {
        "top": "0",
        "right": "0",
        "bottom": "0",
        "left": "0"
      }
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--violet)"
        },
        "typography": {
          "textDecoration": "underline"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--plum)"
          }
        },
        ":focus": {
          "color": {
            "text": "var(--wp--preset--color--plum)"
          }
        }
      },
      "h1": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "800",
          "lineHeight": "0.95",
          "letterSpacing": "-0.02em"
        }
      },
      "h2": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "700",
          "lineHeight": "1.05",
          "letterSpacing": "-0.015em"
        }
      },
      "h3": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "600",
          "lineHeight": "1.25",
          "letterSpacing": "-0.01em"
        }
      },
      "h4": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--body)",
          "fontWeight": "600",
          "lineHeight": "1.35"
        }
      }
    },
    "blocks": {
      "core/separator": {
        "color": {
          "text": "var(--wp--preset--color--hair)"
        }
      },
      "core/quote": {
        "border": {
          "color": "var(--wp--preset--color--hair)"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Menu, sticky dock",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "page-plain",
      "title": "Page, with title",
      "postTypes": [
        "page"
      ]
    }
  ]
}
